# Copy this file to ".env" and fill in your values.
# The real ".env" file is listed in .gitignore, so it is never uploaded.

# --- API key (needed only for live requests; NEVER commit a real key) ---
ANTHROPIC_API_KEY=your-api-key-here

# --- Model and limits (these defaults are used if a line is missing) ---
# Must be a model with a verified price in agent/pricing.py.
ANTHROPIC_MODEL=claude-sonnet-5-5
# How much the model thinks: low | medium | high | xhigh | max
LLM_EFFORT=low
# Hard cap on output tokens per request (thinking + answer)
LLM_MAX_TOKENS=4000
# Session spending cap in US dollars (checked BEFORE every request)
LLM_BUDGET_USD=1.00
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
